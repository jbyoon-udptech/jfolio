# =============================================================================
# jFolio deploy configuration (example)
#
#   cp deploy/production.env.example deploy/production.env
#
# deploy/production.env is gitignored. It holds SSH/connection settings for the
# target and any build-time variables. Runtime application secrets live in
# deploy/production.app.env (see production.app.env.example).
#
# This file is sourced by deploy.sh, so values with spaces must be quoted.
# =============================================================================

# --- OCI instance connection ---
# Public IP or hostname of the OCI compute instance.
DEPLOY_HOST=203.0.113.10
# SSH login user (OCI Ubuntu images default to "ubuntu").
DEPLOY_USER=ubuntu
# SSH port.
DEPLOY_PORT=22
# Private key used to reach the instance. "~" is expanded.
DEPLOY_SSH_KEY=~/.ssh/oci_jfolio
# Absolute directory on the server that holds the release (created if missing).
DEPLOY_PATH=/home/ubuntu/jfolio

# --- Application env file uploaded as <DEPLOY_PATH>/.env ---
# Defaults to deploy/<target>.app.env when unset.
# DEPLOY_APP_ENV_FILE=deploy/production.app.env

# --- Ports used for the post-deploy health check (checked on the server) ---
DEPLOY_API_PORT=3001
DEPLOY_WEB_PORT=3000

# --- Build-time variables (baked into the Next.js build) ---
# Only NEXT_PUBLIC_* values need to be set here; everything else is read at
# runtime from the uploaded .env.
NEXT_PUBLIC_TIME_ZONE=Asia/Seoul
