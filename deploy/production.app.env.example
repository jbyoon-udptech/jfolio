# =============================================================================
# jFolio production application environment (example)
#
#   cp deploy/production.app.env.example deploy/production.app.env
#
# This file is uploaded to <DEPLOY_PATH>/.env on the OCI instance and loaded by
# both PM2 processes (see ecosystem.config.cjs). It is gitignored.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_TIMEZONE=Asia/Seoul
BASE_CURRENCY=KRW

# --- Backend API ---
# Bind to loopback only: the API is reached through the web server / SSH tunnel,
# not exposed directly to the internet.
API_HOST=127.0.0.1
API_PORT=3001
API_BASE_PATH=/api/v1
# Optional trusted service credential. The Next.js server presents it on its
# upstream calls; browsers authenticate with the session cookie instead.
# Set to a long random value in production.
#   openssl rand -hex 32
API_AUTH_TOKEN=change-me-to-a-long-random-token

# --- Authentication / sessions ---
# Local email/password login (Phase 1). Google SSO is reserved for Phase 2.
AUTH_REQUIRED=true
AUTH_LOCAL_ENABLED=true
AUTH_GOOGLE_ENABLED=false

# Required, minimum 32 characters in production:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-session-secret
# Memory sessions are rejected in production; sessions persist in MongoDB.
SESSION_STORE=mongo
SESSION_COOKIE_NAME=jfolio.sid
AUTH_CSRF_COOKIE_NAME=jfolio.csrf
# 7 days.
SESSION_MAX_AGE_MS=604800000
# Sessions are served over HTTPS (directly or through nginx/Next.js).
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# The API is reached through the Next.js proxy, so trust its
# X-Forwarded-Proto header.
SESSION_TRUST_PROXY=true

AUTH_BCRYPT_ROUNDS=12
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Frontend (Next.js) ---
# Port the Next.js server listens on. Open this in the OCI security list /
# firewall (or put nginx in front).
WEB_PORT=3000
# Web server calls the API over loopback and must present the same token.
API_BASE_URL=http://127.0.0.1:3001/api/v1

# --- Database (local mongod on the OCI instance) ---
MONGODB_URI=mongodb://127.0.0.1:27017/jFolio
MONGODB_DB=jFolio

# --- Collection ---
STOCK_COLLECTION_INTERVAL_SECONDS=60
CRYPTO_COLLECTION_INTERVAL_SECONDS=10
FX_COLLECTION_INTERVAL_SECONDS=60

STOCK_PROVIDER=live
CRYPTO_PROVIDER=live
FX_PROVIDER=live
COLLECTION_SCHEDULER_ENABLED=true

# --- Snapshot ---
HOURLY_SNAPSHOT_ENABLED=true
DAILY_SNAPSHOT_ENABLED=true

# --- FX ---
STABLECOIN_USD_PEGS=USDT,USDC,BUSD,DAI,TUSD,FDUSD
