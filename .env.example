# =============================================================================
# jFolio environment configuration (example)
# Copy to `.env` and adjust. NEVER commit real secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_TIMEZONE=Asia/Seoul
BASE_CURRENCY=KRW

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=3001
API_BASE_PATH=/api/v1

# Optional trusted service credential. When set, /api/v1 also accepts
#   Authorization: Bearer <token>   or   x-api-key: <token>
# in addition to a browser session. The Next.js server uses this token for its
# upstream data calls. Leave empty for local development.
API_AUTH_TOKEN=

# --- Authentication / sessions ---
# AUTH_REQUIRED=true means protected pages and /api/v1 require a signed-in
# user. Set to false only for a legacy, account-less local setup.
AUTH_REQUIRED=true
AUTH_LOCAL_ENABLED=true
# Reserved for Phase 2; no Google routes are implemented yet.
AUTH_GOOGLE_ENABLED=false

# Required when auth is enabled. Use a long random value in production:
#   openssl rand -hex 32
SESSION_SECRET=local-development-session-secret-change-me
# "mongo" persists sessions server-side (required in production).
SESSION_STORE=mongo
SESSION_COOKIE_NAME=jfolio.sid
AUTH_CSRF_COOKIE_NAME=jfolio.csrf
# 7 days.
SESSION_MAX_AGE_MS=604800000
# "auto" = Secure in production, not in development. Use true behind HTTPS.
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_SAMESITE=lax
# Trust X-Forwarded-Proto from the Next.js proxy (needed for Secure cookies).
SESSION_TRUST_PROXY=true

# bcrypt cost factor and login rate limit (per IP + email).
AUTH_BCRYPT_ROUNDS=12
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Frontend (Next.js) ---
WEB_PORT=3000
# Server-side API base URL used by Next.js. AUTH_URL is derived from it, or set
# API_AUTH_URL explicitly (e.g. http://127.0.0.1:3001/api/auth).
API_BASE_URL=http://localhost:3001/api/v1

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/jFolio
MONGODB_DB=jFolio

# --- Collection ---
STOCK_COLLECTION_INTERVAL_SECONDS=60
CRYPTO_COLLECTION_INTERVAL_SECONDS=10
FX_COLLECTION_INTERVAL_SECONDS=60

# Provider selection: "live" uses real public APIs, "mock" uses deterministic
# synthetic data. Mixed selection is allowed per asset class.
STOCK_PROVIDER=live
CRYPTO_PROVIDER=live
FX_PROVIDER=live

# Enable the in-process scheduler when the API server starts.
COLLECTION_SCHEDULER_ENABLED=true

# --- Snapshot ---
HOURLY_SNAPSHOT_ENABLED=true
DAILY_SNAPSHOT_ENABLED=true

# --- FX ---
# Crypto quote currencies treated as pegged 1:1 to USD when converting to the
# base currency (stablecoins are not published by fiat FX providers). Set to a
# non-matching value to disable pegging.
STABLECOIN_USD_PEGS=USDT,USDC,BUSD,DAI,TUSD,FDUSD

# --- Provider credentials ---
# The default providers (Binance, Yahoo Chart, Frankfurter) are public and do
# not require an API key. Add credentials here if you plug in a paid provider.
# PROVIDER_A_API_KEY=
